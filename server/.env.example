# ─── API Server ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://wasp:wasp_secret@localhost:5432/whatsapp_saas

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────────────
# Secret para firmar tokens internos (mín. 32 caracteres)
JWT_SECRET=change_me_super_secret_at_least_32_chars

# ─── Rate Limiting ────────────────────────────────────────────
# Requests por minuto por API key (por plan)
RATE_LIMIT_FREE=60
RATE_LIMIT_STARTER=300
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=5000

# ─── Webhook delivery ─────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ─── WhatsApp Sessions ────────────────────────────────────────
# Directorio donde se almacenan las sesiones de Puppeteer
SESSION_PATH=./.wwebjs_sessions

# ─── Puppeteer ────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
