    "bullmq": "^5.7.0",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.5",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.5",
    "nanoid": "^3.3.7",
    "fastify-plugin": "^4.5.1"
