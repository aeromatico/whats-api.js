# ─── WhatsApp SaaS API — Configuración para aPanel ─────────────────────────
# Copiar a .env.production y editar valores

# ─── Entorno ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── API Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_HOST_PORT=3001                    # Puerto en el host (no conflictúe con aPanel)

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# IMPORTANTE: Cambiar contraseña a algo fuerte
POSTGRES_PASSWORD=CAMBIAR_A_CONTRASEÑA_FUERTE_AQUI

# Conexión desde el servidor local (dentro de Docker)
DATABASE_URL=postgresql://wasp:CAMBIAR_A_CONTRASEÑA_FUERTE_AQUI@postgres:5432/whatsapp_saas

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Seguridad ──────────────────────────────────────────────────────────────
# Generar una clave fuerte (mínimo 32 caracteres):
# openssl rand -base64 32
JWT_SECRET=GENERAR_CON_openssl_rand_-base64_32_Y_PEGARLO_AQUI_MINIMO_32

# ─── Rate Limiting (por plan) ───────────────────────────────────────────────
# Requests por minuto
RATE_LIMIT_FREE=60
RATE_LIMIT_STARTER=300
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=5000

# ─── Webhooks ───────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000              # Timeout para entregar webhook (ms)
WEBHOOK_MAX_ATTEMPTS=5                # Reintentos antes de fallar

# ─── WhatsApp Sessions ───────────────────────────────────────────────────────
# Directorio donde se almacenan las sesiones de Puppeteer
SESSION_PATH=./.wwebjs_sessions

# ─── Puppeteer (Chromium) ────────────────────────────────────────────────────
# Ruta a Chromium (déjar vacío si Docker puede encontrarlo)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ─── CORS (para desarrollo/testing) ─────────────────────────────────────────
# En producción, dejar en false o especificar dominios permitidos
# ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ─── Logs ────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
